{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/lookup-video", "destination": "/api/external?route=lookup-video" },
    { "source": "/api/lookup-isbn", "destination": "/api/external?route=lookup-isbn" },
    { "source": "/api/lookup-disc", "destination": "/api/external?route=lookup-disc" },
    { "source": "/api/upload-cover", "destination": "/api/external?route=upload-cover" },
    { "source": "/api/media/(.*)", "destination": "/api/media?path=$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
