{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/lookup-isbn", "destination": "/api/external?route=lookup-isbn" },
    { "source": "/api/lookup-disc", "destination": "/api/external?route=lookup-disc" },
    { "source": "/api/upload-cover", "destination": "/api/external?route=upload-cover" },
    { "source": "/api/media/:path*", "destination": "/api/media?path=:path*" },
    { "source": "/", "destination": "/index.html" },
    {
      "source": "/:path((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
