# ============================================
# BACKEND API - Vercel Functions
# ============================================
# Estas variables son SOLO para el backend (Vercel Functions)
# NO son accesibles desde el frontend
# IMPORTANTE: Configura estas variables en Vercel Dashboard
# Settings > Environment Variables

# URL de tu base de datos Turso (obligatorio para API y scripts)
TURSO_DATABASE_URL=https://catalogo-prueba-marcosgarciagarcia.aws-eu-west-1.turso.io

# Token de autenticación de Turso (READ/WRITE)
TURSO_AUTH_TOKEN=tu_token_aqui

# Base de datos local (opcional). Si está definida, init-tipos-coleccion se ejecuta también en local.
# Ejemplo: file:./data/catalogo.db  (ruta relativa a la raíz del proyecto)
# LOCAL_DATABASE_URL=file:./data/catalogo.db

# Secret para firmar JWT (cambiar en producción)
JWT_SECRET=tu_secret_key_super_seguro_aqui

# ============================================
# FRONTEND - Variables públicas
# ============================================
# Estas variables SÍ son accesibles desde el frontend
# Usa el prefijo VITE_ para que Vite las exponga

# URL base de la API (opcional). En producción same-origin suele ser ''.
# Solo necesario si el frontend se sirve desde otro dominio.
# VITE_API_BASE_URL=https://tu-dominio.vercel.app

# Cloudinary: subida de portadas desde el formulario de alta (unsigned upload)
# Crear un "Upload preset" sin firmar en Cloudinary > Settings > Upload
# VITE_CLOUDINARY_CLOUD_NAME=casateca
# VITE_CLOUDINARY_UPLOAD_PRESET=books_unsigned

# ============================================
# Tabla de usuarios para login (Turso)
# ============================================
# La API de login espera una tabla core_users con:
#   id INTEGER PRIMARY KEY,
#   username TEXT UNIQUE NOT NULL,
#   password_hash TEXT NOT NULL,
#   email TEXT,
#   is_staff INTEGER DEFAULT 0,
#   is_admin INTEGER DEFAULT 0
# Crear usuarios con contraseña hasheada con bcrypt (cost 10).
